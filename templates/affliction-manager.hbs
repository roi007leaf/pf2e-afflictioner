<div class="affliction-manager-content">
  <div class="affliction-manager-tabs">
    {{#if canManageAfflictions}}
    <button type="button" class="affliction-manager-tab-btn active" data-tab="afflictions">
      <i class="fas fa-biohazard"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.TAB_AFFLICTIONS"}}
    </button>
    {{/if}}
    <button type="button" class="affliction-manager-tab-btn" data-tab="coatings">
      <i class="fas fa-flask"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.TAB_LABEL"}}
      {{#if hasAnyCoating}}<span class="coating-badge">{{#each actorsWithWeapons}}{{#each weapons}}{{#if isCoated}}1{{else}}{{#if isInjectionLoaded}}1{{/if}}{{/if}}{{/each}}{{/each}}</span>{{/if}}
    </button>
    {{#if canManageAfflictions}}
    <button type="button" class="affliction-manager-tab-btn" data-tab="overrides">
      <i class="fas fa-user-shield"></i> {{localize "PF2E_AFFLICTIONER.MANAGER.OVERRIDES_TAB"}}
    </button>
    {{/if}}
  </div>

  {{#if playerCoatingOnly}}
    <p class="coating-hint"><i class="fas fa-info-circle"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.PLAYER_LIMITED_HINT"}}</p>
  {{/if}}

  {{#if canManageAfflictions}}
  <div class="affliction-manager-tab-panel" data-tab="afflictions">
    {{#if hasAfflictions}}
      {{#each tokens}}
        <div class="token-section">
          <div class="token-header">
            <img src="{{img}}" alt="{{name}}" />
            <h3>{{name}}</h3>
          </div>

          {{#each afflictions}}
            <div class="affliction-row">
              <div class="affliction-info">
                <h4>
                  {{name}} ({{type}})
                  {{#if isVirulent}}
                    <span style="color: #c45500; font-size: 0.85em; font-weight: normal;" data-tooltip="Requires two consecutive successes to reduce stage by 1. Critical success reduces by 1 instead of 2.">[Virulent]</span>
                  {{/if}}
                  {{#if hasMultipleExposure}}
                    <span style="color: #0066cc; font-size: 0.85em; font-weight: normal;" data-tooltip="Re-exposure increases stage by {{multipleExposureIncrease}}">[Multiple Exposure +{{multipleExposureIncrease}}]</span>
                  {{/if}}
                  {{#if hasWarning}}
                    <i class="fas fa-exclamation-triangle" style="color: #ff6b00;" data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.MANUAL_HANDLING_REQUIRED'}}"></i>
                  {{/if}}
                </h4>
                <div class="affliction-details">
                  <span class="stage">
                    {{stageDisplay}}
                    <i class="fas fa-info-circle stage-info" data-tooltip="{{stageTooltip}}"></i>
                  </span>
                  <span class="next-save">{{localize 'PF2E_AFFLICTIONER.MANAGER.NEXT_SAVE'}}: {{nextSaveDisplay}}</span>
                  <span class="treatment">{{treatmentDisplay}}</span>
                </div>
              </div>

              <div class="affliction-actions">
                <button type="button" data-action="editAffliction"
                        data-affliction-id="{{id}}" data-token-id="{{../tokenId}}" data-actor-id="{{../actorId}}"
                        data-tooltip="{{localize 'PF2E_AFFLICTIONER.EDITOR.EDIT_AFFLICTION'}}">
                  <i class="fas fa-pencil-alt"></i>
                </button>
                <button type="button" data-action="rollSave"
                        data-affliction-id="{{id}}" data-token-id="{{../tokenId}}" data-actor-id="{{../actorId}}"
                        data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.ROLL_SAVE'}}">
                  <i class="fas fa-dice-d20"></i>
                </button>
                {{#if hasDamage}}
                <button type="button" data-action="rollDamage"
                        data-affliction-id="{{id}}" data-token-id="{{../tokenId}}" data-actor-id="{{../actorId}}"
                        data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.ROLL_DAMAGE'}}">
                  <i class="fas fa-heart-broken"></i>
                </button>
                {{/if}}
                <button type="button" data-action="treatAffliction"
                        data-affliction-id="{{id}}" data-token-id="{{../tokenId}}" data-actor-id="{{../actorId}}"
                        data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.TREAT'}}">
                  <i class="fas fa-medkit"></i>
                </button>
                <button type="button" data-action="counteractAffliction"
                        data-affliction-id="{{id}}" data-token-id="{{../tokenId}}" data-actor-id="{{../actorId}}"
                        data-tooltip="Counteract affliction (e.g., Cleanse Affliction spell)">
                  <i class="fas fa-shield-alt"></i>
                </button>
                <button type="button" data-action="progressStage"
                        data-affliction-id="{{id}}" data-token-id="{{../tokenId}}" data-actor-id="{{../actorId}}"
                        data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.PROGRESS_STAGE'}}"
                        {{#unless canProgressStage}}disabled{{/unless}}>
                  <i class="fas fa-arrow-up"></i>
                </button>
                <button type="button" data-action="regressStage"
                        data-affliction-id="{{id}}" data-token-id="{{../tokenId}}" data-actor-id="{{../actorId}}"
                        data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.REGRESS_STAGE'}}"
                        {{#unless canRegressStage}}disabled{{/unless}}>
                  <i class="fas fa-arrow-down"></i>
                </button>
                <button type="button" data-action="removeAffliction"
                        data-affliction-id="{{id}}" data-token-id="{{../tokenId}}" data-actor-id="{{../actorId}}"
                        data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.REMOVE_AFFLICTION'}}">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            </div>
          {{/each}}
        </div>
      {{/each}}
    {{else}}
      <p class="no-afflictions">{{localize 'PF2E_AFFLICTIONER.MANAGER.NO_AFFLICTIONS'}}</p>
    {{/if}}

    <div class="manager-footer">
      <button type="button" data-action="addAffliction" data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.ADD_AFFLICTION'}}">
        <i class="fas fa-plus"></i> {{localize 'PF2E_AFFLICTIONER.MANAGER.ADD_AFFLICTION'}}
      </button>
      {{#if hasAfflictions}}
      <button type="button" data-action="clearAllAfflictions" class="clear-all-button" data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.CLEAR_ALL'}}">
        <i class="fas fa-trash-alt"></i> {{localize 'PF2E_AFFLICTIONER.MANAGER.CLEAR_ALL'}}
      </button>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{#if canManageAfflictions}}
  <div class="affliction-manager-tab-panel" data-tab="overrides" style="display:none">
    {{#if sourceRuleActor}}
      <div class="source-immunity-bypass-rule">
        <div class="source-rule-header">
          <div>
            <h4><i class="fas fa-user-shield"></i> {{localize "PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_RULE_TITLE"}}</h4>
            <span>{{sourceRuleActor.name}}</span>
          </div>
          <label class="source-rule-toggle">
            <input type="checkbox" name="sourceRule.enabled" {{#if sourceImmunityBypassRule.enabled}}checked{{/if}} />
            {{localize "PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_RULE_ENABLED"}}
          </label>
        </div>
        <label class="source-rule-traits">
          <span>{{localize "PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_TRAITS"}}</span>
          <div class="source-rule-trait-tags">
            {{#each sourceImmunityBypassRule.traitTags}}
              <span class="source-rule-trait-tag" data-trait="{{value}}">
                <span class="source-rule-trait-label">{{label}}</span>
                <button type="button" class="source-rule-trait-remove" data-action="removeSourceRuleTrait" data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_REMOVE_TRAIT'}}">
                  <i class="fas fa-times"></i>
                </button>
              </span>
            {{/each}}
          </div>
          <div class="source-rule-trait-entry">
            <input type="text" class="source-rule-trait-input" list="source-rule-trait-options" placeholder="Add immunity trait..." />
            <button type="button" class="source-rule-trait-add" data-action="addSourceRuleTrait" data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_ADD_TRAIT'}}">
              <i class="fas fa-plus"></i>
            </button>
          </div>
          <datalist id="source-rule-trait-options">
            {{#each sourceRuleTraitOptions}}
              <option value="{{value}}"></option>
            {{/each}}
          </datalist>
        </label>
        <label class="source-rule-keys">
          <span>{{localize "PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_AFFLICTION_KEYS"}}</span>
          <div class="source-rule-key-tags">
            {{#each sourceImmunityBypassRule.afflictionKeyTags}}
              <span class="source-rule-key-tag" data-key="{{key}}" data-name="{{name}}" data-uuid="{{uuid}}">
                <button type="button" class="source-rule-key-open" data-action="openSourceRuleAffliction" data-uuid="{{uuid}}" data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_OPEN_AFFLICTION'}}">
                  <i class="fas fa-circle-info"></i> {{name}}
                </button>
                <button type="button" class="source-rule-key-remove" data-action="removeSourceRuleAffliction" data-tooltip="{{localize 'PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_REMOVE_AFFLICTION'}}">
                  <i class="fas fa-times"></i>
                </button>
              </span>
            {{/each}}
          </div>
        </label>
        <div class="source-rule-footer">
          <p>{{localize "PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_RULE_HINT"}}</p>
          <button type="button" data-action="saveSourceImmunityBypassRule" data-actor-id="{{sourceRuleActor.id}}">
            <i class="fas fa-save"></i> {{localize "PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_RULE_SAVE"}}
          </button>
        </div>
      </div>
    {{else}}
      <p class="no-afflictions">{{localize "PF2E_AFFLICTIONER.MANAGER.SOURCE_IMMUNITY_RULE_NO_ACTOR"}}</p>
    {{/if}}
  </div>
  {{/if}}

  <div class="affliction-manager-tab-panel" data-tab="coatings" {{#if canManageAfflictions}}style="display:none"{{/if}}>
    {{#if hasWeapons}}
      {{#unless hasInjuryItems}}
        <p class="coating-hint"><i class="fas fa-info-circle"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.NO_POISONS_HINT"}}</p>
      {{/unless}}

      {{#each actorsWithWeapons}}
        <div class="coating-actor-section">
          {{#each weapons}}
            <div class="weapon-row {{#if isCoated}}is-coated{{/if}} {{#if isInjectionLoaded}}is-injection-loaded{{/if}}">
              <div class="weapon-info">
                <span class="weapon-name"><i class="fas fa-sword"></i> {{weaponName}}</span>
                <span class="weapon-damage-type">({{damageType}})</span>
                {{#if isCoated}}
                  <span class="weapon-poison-label" data-tooltip="{{coatingTooltip}}"><i class="fas fa-flask"></i> {{poisonName}}</span>
                  {{#if poisonItemUuid}}
                  <button type="button" class="coating-info-btn" data-action="openPoisonItem"
                          data-uuid="{{poisonItemUuid}}"
                          data-tooltip="Open item sheet">
                    <i class="fas fa-circle-info"></i>
                  </button>
                  {{/if}}
                  {{#each componentPoisonLinks}}
                  <button type="button" class="coating-info-btn" data-action="openPoisonItem"
                          data-uuid="{{uuid}}"
                          data-tooltip="{{name}}">
                    <i class="fas fa-circle-info"></i>
                  </button>
                  {{/each}}
                {{/if}}
                {{#if isInjectionLoaded}}
                  <span class="weapon-injection-label" data-tooltip="{{injectionTooltip}}"><i class="fas fa-syringe"></i> {{injectionName}}</span>
                  {{#if injectionItemUuid}}
                  <button type="button" class="coating-info-btn" data-action="openPoisonItem"
                          data-uuid="{{injectionItemUuid}}"
                          data-tooltip="Open item sheet">
                    <i class="fas fa-circle-info"></i>
                  </button>
                  {{/if}}
                {{/if}}
              </div>
              <div class="weapon-coating-controls">
                {{#if canCoat}}
                {{#if isCoated}}
                  <button type="button" class="coating-remove-btn" data-action="removeCoating"
                          data-actor-id="{{actorId}}" data-weapon-id="{{weaponId}}"
                          data-tooltip="{{localize 'PF2E_AFFLICTIONER.WEAPON_COATING.REMOVE_COATING'}}">
                    <i class="fas fa-times"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.REMOVE_COATING"}}
                  </button>
                  {{#if canAddDoublePoison}}
                    {{#if ../../hasInjuryItems}}
                      <input type="checkbox" class="double-poison-checkbox" name="doublePoison.enabled" id="double-poison-{{actorId}}-{{weaponId}}" />
                      <label class="double-poison-toggle" for="double-poison-{{actorId}}-{{weaponId}}">
                        {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.DOUBLE_POISON_TOGGLE"}}
                      </label>
                      <div class="double-poison-controls">
                        <div class="weapon-control-pair">
                          <select class="coating-poison-select">
                            <option value="">{{localize "PF2E_AFFLICTIONER.WEAPON_COATING.SELECT_SECOND_POISON"}}</option>
                            {{#each ../../injuryItems}}
                              <option value="{{uuid}}">{{name}}{{#if ownerName}} ({{ownerName}}){{/if}}</option>
                            {{/each}}
                          </select>
                          <button type="button" class="coating-apply-btn" data-action="addCoating"
                                  data-actor-id="{{actorId}}" data-weapon-id="{{weaponId}}"
                                  data-double-poison="true"
                                  data-tooltip="{{localize 'PF2E_AFFLICTIONER.WEAPON_COATING.APPLY_SECOND_COATING_TOOLTIP'}}">
                            <i class="fas fa-flask"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.ADD_SECOND_POISON_BTN"}}
                          </button>
                        </div>
                      </div>
                    {{/if}}
                  {{/if}}
                {{else}}
                  {{#if ../../hasInjuryItems}}
                    <div class="weapon-control-pair">
                      <select class="coating-poison-select">
                        <option value="">{{localize "PF2E_AFFLICTIONER.WEAPON_COATING.SELECT_POISON"}}</option>
                        {{#each ../../injuryItems}}
                          <option value="{{uuid}}">{{name}}{{#if ownerName}} ({{ownerName}}){{/if}}</option>
                        {{/each}}
                      </select>
                      <button type="button" class="coating-apply-btn" data-action="addCoating"
                              data-actor-id="{{actorId}}" data-weapon-id="{{weaponId}}"
                              data-tooltip="{{localize 'PF2E_AFFLICTIONER.WEAPON_COATING.APPLY_COATING_TOOLTIP'}}">
                        <i class="fas fa-flask"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.COAT_WEAPON_BTN"}}
                      </button>
                    </div>
                  {{else}}
                    <span class="no-poisons-hint">{{localize "PF2E_AFFLICTIONER.WEAPON_COATING.NO_POISONS_AVAILABLE"}}</span>
                  {{/if}}
                {{/if}}
                {{/if}}
                {{#if hasInjectionTrait}}
                  {{#if isInjectionLoaded}}
                    <button type="button" class="injection-remove-btn" data-action="removeInjection"
                            data-actor-id="{{actorId}}" data-weapon-id="{{weaponId}}"
                            data-tooltip="{{localize 'PF2E_AFFLICTIONER.WEAPON_COATING.REMOVE_INJECTION'}}">
                      <i class="fas fa-times"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.REMOVE_INJECTION"}}
                    </button>
                  {{else}}
                    {{#if ../../hasInjuryItems}}
                      <div class="weapon-control-pair">
                        <select class="injection-poison-select">
                          <option value="">{{localize "PF2E_AFFLICTIONER.WEAPON_COATING.SELECT_INJECTION_POISON"}}</option>
                          {{#each ../../injuryItems}}
                            <option value="{{uuid}}">{{name}}{{#if ownerName}} ({{ownerName}}){{/if}}</option>
                          {{/each}}
                        </select>
                        <button type="button" class="injection-apply-btn" data-action="addInjection"
                                data-actor-id="{{actorId}}" data-weapon-id="{{weaponId}}"
                                data-tooltip="{{localize 'PF2E_AFFLICTIONER.WEAPON_COATING.LOAD_INJECTION_TOOLTIP'}}">
                          <i class="fas fa-syringe"></i> {{localize "PF2E_AFFLICTIONER.WEAPON_COATING.LOAD_INJECTION_BTN"}}
                        </button>
                      </div>
                    {{/if}}
                  {{/if}}
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      {{/each}}
    {{else}}
      <p class="no-afflictions">{{localize "PF2E_AFFLICTIONER.WEAPON_COATING.NO_WEAPONS"}}</p>
    {{/if}}
  </div>
</div>
